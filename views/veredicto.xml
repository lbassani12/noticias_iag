<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_iag_veredicto_tree" model="ir.ui.view">
    <field name="name">iag.veredicto.tree</field>
    <field name="model">iag.veredicto</field>
    <field name="arch" type="xml">
      <tree create="0" edit="0" delete="0">
        <field name="id"/>
        <field name="analisis_id"/>
        <field name="estado" widget="badge" decoration-success="estado == 'valido'" decoration-warning="estado == 'observado'" decoration-danger="estado == 'no_sustentado'"/>
        <field name="confianza"/>
        <field name="fecha_registro"/>
      </tree>
    </field>
  </record>

  <!-- Formulario del revisor humano: análisis y evidencia lado a lado; sólo crea, nunca edita. -->
  <record id="view_iag_veredicto_form" model="ir.ui.view">
    <field name="name">iag.veredicto.form</field>
    <field name="model">iag.veredicto</field>
    <field name="arch" type="xml">
      <form string="Veredicto" edit="0" delete="0">
        <header>
          <button name="action_emitir" string="Emitir veredicto" type="object" class="btn-primary" attrs="{'invisible': [('id', '!=', False)]}" help="Guarda el veredicto y abre el siguiente análisis pendiente del estudio, o vuelve al estudio si no queda ninguno."/>
          <button name="action_emitir" string="Siguiente pendiente" type="object" class="btn-secondary" attrs="{'invisible': [('id', '=', False)]}"/>
        </header>
        <sheet>
          <field name="id" invisible="1"/>
          <div class="alert alert-secondary mb-3" role="status" attrs="{'invisible': [('id', '!=', False)]}">
            <strong>Cómo emitir el veredicto.</strong>
            1) Leé el análisis (izquierda) contra la evidencia (derecha), con el criterio de validez del estudio como regla.
            2) En <em>Sustento</em>, cada fila es una afirmación del análisis: indicá si la evidencia la <em>respalda</em>, la <em>contradice</em> o <em>no hay evidencia</em>, y pegá el fragmento literal en que te basás. Podés agregar o quitar filas.
            3) Elegí el <em>estado</em>: válido si todas las afirmaciones están respaldadas; observado si alguna carece de evidencia; no sustentado si la mayoría carece de evidencia o hay contradicciones.
            4) Poné la <em>confianza</em> entre 0 y 1 y apretá <strong>Emitir veredicto</strong>.
          </div>
          <div class="row">
            <div class="col-lg-6">
              <h5 class="mb-2">Criterio de validez del estudio</h5>
              <div class="mb-2"><span class="text-muted me-2">Estudio:</span><field name="estudio_id" readonly="1" options="{'no_open': True}" class="d-inline"/></div>
              <div class="alert alert-info mb-0" role="status">
                <field name="criterio_validez" readonly="1" nolabel="1" class="w-100"/>
              </div>
            </div>
            <div class="col-lg-6">
              <h5 class="mb-2">Veredicto</h5>
              <group>
                <field name="analisis_id" attrs="{'readonly': [('id', '!=', False)]}" options="{'no_create': True, 'no_open': True}"/>
                <field name="estado" widget="radio" attrs="{'readonly': [('id', '!=', False)]}"/>
                <field name="confianza" attrs="{'readonly': [('id', '!=', False)]}" help="Fidelidad del análisis a la evidencia, entre 0 y 1."/>
                <field name="fecha_registro" attrs="{'invisible': [('id', '=', False)]}"/>
              </group>
            </div>
          </div>
          <div class="row mt-4">
            <div class="col-lg-6">
              <h5 class="mb-2">Análisis juzgado</h5>
              <field name="analisis_contenido_texto" readonly="1" nolabel="1" class="w-100" style="font-family: monospace; font-size: 0.9em"/>
            </div>
            <div class="col-lg-6">
              <h5 class="mb-2">Evidencia (material empírico del prompt)</h5>
              <field name="evidencia_texto" readonly="1" nolabel="1" class="w-100"/>
            </div>
          </div>
          <notebook class="mt-4">
            <page string="Sustento" name="sustento">
              <p class="text-muted">Las filas vienen precargadas con las afirmaciones que el propio análisis declaró y el fragmento que citó; la relación con la evidencia queda vacía a propósito, la decide el revisor. Agregá filas si el análisis afirma cosas que no listó.</p>
              <field name="sustento_ids" nolabel="1" attrs="{'readonly': [('id', '!=', False)]}">
                <tree editable="bottom">
                  <field name="sequence" widget="handle"/>
                  <field name="afirmacion"/>
                  <field name="relacion"/>
                  <field name="fragmento"/>
                  <field name="link" widget="url" optional="show"/>
                </tree>
              </field>
            </page>
            <page string="Sustento (JSON del contrato)" name="sustento_json">
              <field name="sustento_texto" nolabel="1" readonly="1" style="font-family: monospace"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_iag_veredicto" model="ir.actions.act_window">
    <field name="name">Veredictos</field>
    <field name="res_model">iag.veredicto</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'create': False}</field>
  </record>
</odoo>
